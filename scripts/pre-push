#!/bin/sh
# Safety net for the public starter repo.
# Blocks any push whose diff contains private data (server details,
# personal names, class context, credential shapes) or a private filename.
# The private data lives in the private repo; this repo is the public
# starter and must stay generic.
#
# Install into a fresh clone with: scripts/install-hooks.sh
#
# Note: this file itself contains the forbidden patterns (as patterns),
# so the content scan excludes scripts/pre-push and
# scripts/install-hooks.sh.

set -eu

CONTENT_PATTERNS='206\.189\.95\.20|tim-sg1|timyang|Tim Yang|David|instructor|course project|class presentation|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}'
# Anchored to the full path, so knowledge.md.example and .env.example stay allowed.
FILE_PATTERNS='(^|/)docs/process\.md$|(^|/)PRIVATE-NOTES\.md$|(^|/)knowledge\.md$|(^|/)tweets[^/]*\.js$|(^|/)note-tweet\.js$|(^|/)posts\.(json|txt)$|(^|/)stats\.json$|(^|/)\.env$'

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # empty tree
  else
    base="$remote_sha"
  fi

  # 1. Private filenames in the pushed diff.
  if git diff --name-only "$base" "$local_sha" | grep -Eiq "$FILE_PATTERNS"; then
    echo "BLOCKED: push contains a private file:" >&2
    git diff --name-only "$base" "$local_sha" | grep -Ei "$FILE_PATTERNS" >&2
    fail=1
  fi

  # 2. Private content in the pushed diff (excluding this hook itself).
  if git diff "$base" "$local_sha" -- . ':!scripts/pre-push' ':!scripts/install-hooks.sh' | grep -Eiq "$CONTENT_PATTERNS"; then
    echo "BLOCKED: push contains private content:" >&2
    git diff "$base" "$local_sha" -- . ':!scripts/pre-push' ':!scripts/install-hooks.sh' | grep -Ein "$CONTENT_PATTERNS" | head -20 >&2
    fail=1
  fi
done

if [ "$fail" = 1 ]; then
  echo "Push aborted. Remove the private file/content and try again." >&2
  echo "This is the public starter repo — private data lives in the private repo." >&2
  exit 1
fi
exit 0
