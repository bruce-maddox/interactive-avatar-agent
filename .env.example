# Copy to .env and fill in. Never commit a real key.
# Get one at https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# Optional: a context (persona + greeting) you created via POST /v1/contexts.
# Without one the avatar may stream video but stay silent.
LIVEAVATAR_CONTEXT_ID=

# Optional: voice for the avatar. Video avatars have a default voice;
# image avatars REQUIRE a voice_id. Get IDs via GET /v1/voices.
LIVEAVATAR_VOICE_ID=

# Port for `node server.mjs` (default 3000).
PORT=3000
